{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: dev (external browser)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "internalConsoleOptions": "neverOpen",
      "serverReadyAction": {
        "pattern": "http://[^\\s]+",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}